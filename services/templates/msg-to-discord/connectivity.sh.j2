#!/bin/bash
# The local probe sends Discord-native content; the gateway probe sends msg.
set -euo pipefail
{% if local_testing %}
URL="https://mock.unitysvc.dev/discord/api/webhooks/demo/demotoken"
HEADERS=(-H "Content-Type: application/json")
BODY='{"username":"Example sender - Example room","avatar_url":"https://avatars.githubusercontent.com/u/280703328","content":"Connectivity check: a plain message."}'
{% else %}
URL="{{ service_base_url }}"
HEADERS=(-H "Content-Type: application/json" -H "Authorization: Bearer ${UNITYSVC_API_KEY}")
BODY='{"title":"Example sender - Example room","avatar_url":"https://avatars.githubusercontent.com/u/280703328","body":"Connectivity check: a plain message.","format":"text"}'
{% endif %}
status=$(curl -sS --max-time 15 -X POST "${HEADERS[@]}" -d "$BODY" -o /dev/null -w '%{http_code}' "$URL")
case "$status" in
  2??) echo "connectivity ok (HTTP $status)" ;;
  *) echo "connectivity failed (HTTP $status)" >&2; exit 1 ;;
esac
